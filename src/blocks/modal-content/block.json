{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pikari-gutenberg-modals/modal-content",
	"version": "0.1.0",
	"title": "Modal Content",
	"category": "design",
	"description": "Stores inline modal content on the page. Triggers can reference this block to display content without a REST API call.",
	"textdomain": "pikari-gutenberg-modals",
	"keywords": ["modal", "popup", "dialog", "content", "inline"],
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"anchor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"reusable": false
	},
	"editorScript": "file:../../../build/blocks/modal-content/index.js",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php"
}
