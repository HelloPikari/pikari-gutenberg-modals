{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pikari-gutenberg-modals/content-area",
	"version": "0.1.0",
	"title": "Modal Content Area",
	"category": "design",
	"description": "The area where modal content is dynamically loaded. Place inside the modal template part.",
	"textdomain": "pikari-gutenberg-modals",
	"ancestor": ["pikari-gutenberg-modals/modal-dialog"],
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false,
		"spacing": {
			"margin": true,
			"__experimentalDefaultControls": {
				"margin": true
			}
		}
	},
	"editorScript": "file:../../../build/blocks/content-area/index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
